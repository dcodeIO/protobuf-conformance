{
  "name": "protobuf-es-conformance",
  "conformanceMeta": {
    "name": "protobuf-ts",
    "githubUrl": "https://github.com/timostamm/protobuf-ts",
    "versionPackage": "@protobuf-ts/plugin",
    "maximumEdition": "proto3",
    "javascript": true,
    "typescript": true,
    "standardPlugin": true
  },
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bash generate.sh",
    "build": "tsc --noEmit",
    "test": "conformance_test_runner --maximum_edition 2024 --enforce_recommended --failure_list failing_tests.txt --text_format_failure_list failing_tests_text_format.txt --output_dir . runner.ts"
  },
  "dependencies": {
    "@protobuf-ts/plugin": "^2.11.1",
    "@protobuf-ts/runtime": "^2.9.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
