{
  "name": "google-protobuf-conformance",
  "conformanceMeta": {
    "name": "google-protobuf",
    "githubUrl": "https://github.com/protocolbuffers/protobuf-javascript",
    "versionPackage": "google-protobuf",
    "maximumEdition": "2023",
    "javascript": true,
    "typescript": false,
    "typescriptNote": "Runtime typings are available via Definitely Typed. Declarations for generated code require a third-party declaration generator.",
    "standardPlugin": true
  },
  "private": true,
  "scripts": {
    "generate": "buf generate",
    "test": "conformance_test_runner --maximum_edition 2024 --enforce_recommended --failure_list failing_tests.txt --text_format_failure_list failing_tests_text_format.txt --output_dir . runner.js"
  },
  "dependencies": {
    "google-protobuf": "^4.0.2",
    "@protocolbuffers/protoc-gen-js": "^4.0.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0"
  }
}
