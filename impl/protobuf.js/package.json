{
  "name": "protobuf.js-conformance",
  "conformanceMeta": {
    "name": "protobuf.js",
    "githubUrl": "https://github.com/protobufjs/protobuf.js",
    "versionPackage": "protobufjs",
    "maximumEdition": "2024",
    "javascript": true,
    "typescript": true,
    "standardPlugin": true
  },
  "private": true,
  "type": "module",
  "scripts": {
    "pregenerate": "rm -rf gen/*",
    "generate": "bash generate.sh",
    "build": "tsc --noEmit",
    "test": "conformance_test_runner --maximum_edition 2024 --enforce_recommended --failure_list failing_tests.txt --text_format_failure_list failing_tests_text_format.txt --output_dir . runner.ts"
  },
  "dependencies": {
    "long": "^5.3.2",
    "protobufjs": "^8.6.3",
    "protobufjs-cli": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
